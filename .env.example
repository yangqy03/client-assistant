# Copy to .env.local and fill the key locally. Never put it in chat or Git.
MODEL_PROVIDER=openai
OPENAI_API_KEY=
# Configurable; this model supports structured output through Responses API.
OPENAI_MODEL=gpt-6.1-sol

# Optional legacy connection; only used when MODEL_PROVIDER=gateway.
AI_GATEWAY_API_KEY=
AI_MODEL=

# Public hosting: 1 disables live generation in both UI and API. Leave unset locally.
# NEXT_PUBLIC_DEMO_ONLY=1
